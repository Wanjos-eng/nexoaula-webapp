Ref: meeting_topics.subject_topic_id > subject_topics.id [delete: restrict]

Ref: tutor_profiles.user_id > users.id [delete: restrict]
Ref: tutor_subjects.tutor_user_id > tutor_profiles.user_id [delete: cascade]
Ref: tutor_subjects.subject_id > subjects.id [delete: restrict]
Ref: tutor_subject_topics.tutor_user_id > tutor_profiles.user_id [delete: cascade]
