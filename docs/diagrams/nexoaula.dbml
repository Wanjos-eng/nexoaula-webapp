Ref: transactions.(session_booking_id, buyer_id) > session_bookings.(id, user_id) [delete: restrict]
Ref: reviews.transaction_id > transactions.id [delete: restrict]

//////////////////////////////////////////////
// TABLE GROUPS
//////////////////////////////////////////////

TableGroup identity [color: #4F46E5, note: 'Conta, perfil e autenticacao'] {
  users
  user_profiles
  auth_tokens
}

TableGroup media [color: #64748B, note: 'Referencias de arquivos externos'] {
  files
}

TableGroup academic [color: #0284C7, note: 'Estrutura institucional e ofertas de disciplinas'] {
  institutions
  courses
  subjects
  course_subjects
  academic_terms
  teachers
  class_sections
  class_section_teachers
  class_section_schedules
  user_class_sections
}

TableGroup academic_planning [color: #16A34A, note: 'Previsto, realizado e registros pessoais'] {
  topics
  subject_topics
  teaching_plans
  teaching_plan_imports
  scheduled_lessons
  scheduled_lesson_topics
  lesson_occurrences
  occurrence_topics
  student_lesson_attendance
  student_topic_progress
  planning_corrections
}

TableGroup community [color: #D97706, note: 'Grupos, canais, mensagens e encontros gratuitos'] {
  study_groups
  group_members
  group_join_requests
  group_topics
  channels
  channel_messages
  meetings
  meeting_participants
  meeting_topics
}

TableGroup marketplace [color: #9333EA, note: 'Tutores, materiais, sessoes e transacoes simuladas'] {
  tutor_profiles
  tutor_subjects
  tutor_subject_topics
  tutor_credentials
  materials
  material_topics
  tutor_sessions
  session_topics
  session_bookings
  transactions
  reviews
}