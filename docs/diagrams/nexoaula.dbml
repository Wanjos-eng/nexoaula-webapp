Project nexoaula {
  database_type: 'PostgreSQL'
  Note: 'Modelo conceitual e logico oficial do nexoAula. PREVISTO fica em teaching_plans e scheduled_lessons; REALIZADO em lesson_occurrences; MEU REGISTRO em student_lesson_attendance e student_topic_progress. Monetizacao e modular e publicidade permanece fora do modelo fisico.'
}

//////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////

Enum file_purpose {
  avatar
  group_cover
  teaching_plan_source
  material_content
}

Enum auth_token_type {
  email_verification
  password_reset
}

Enum section_teacher_role {
  lead
  assistant
  substitute
}

Enum teaching_plan_status {
  draft
  published
  superseded
}

Enum teaching_plan_import_status {
  pending
  processing
  review_required
  reviewed
  applied
  rejected
  failed
}

Enum lesson_occurrence_status {
  held
  cancelled
  postponed
}

Enum attendance_status {
  present
  absent
}

Enum topic_progress_status {
  pending
  reviewing
  mastered
}

Enum planning_correction_kind {
  schedule
  topics
  status
  details
  other
}

Enum correction_status {
  pending
  approved
  rejected
}

Enum group_visibility {
  public
  unlisted
  private
}

Enum group_join_policy {
  open
  approval_required
  invite_only
}

Enum group_status {
  active
  archived
  closed
}

Enum membership_role {
  owner
  moderator
  member
}

Enum membership_status {
  active
  left
  removed
}

Enum join_request_status {
  pending
  approved
  rejected
  cancelled
}

Enum channel_status {
  active
  archived
}

Enum meeting_modality {
  in_person
  online
  hybrid
}

Enum meeting_status {
  scheduled
  completed
  cancelled
}

Enum meeting_participant_status {
  interested
  confirmed
  cancelled
}

Enum tutor_profile_status {
  active
  paused
  suspended
}

Enum tutor_credential_status {
  pending
  approved
  rejected
  expired
  revoked
}

Enum material_status {
  draft
  published
  archived
}

Enum tutor_session_status {
  draft
  scheduled
  completed
  cancelled
}

Enum session_booking_status {
  reserved
  confirmed
  cancelled
  attended
  no_show
}

Enum transaction_status {
  pending
  completed
  failed
  refunded
  cancelled
}

//////////////////////////////////////////////
// IDENTITY
//////////////////////////////////////////////

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  email varchar(320) [not null]
  password_hash text [not null]
  email_verified_at timestamptz
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Note: 'Identidade e credenciais. A senha existe apenas como hash. A unicidade do e-mail e case-insensitive por indice em lower(email).'

  indexes {
    (`lower(email)`) [unique, name: 'uq_users_email_ci']
  }
}

Table user_profiles {
  user_id uuid [pk]
  display_name varchar(120) [not null]
  bio text
  avatar_file_id uuid
  institution_id uuid
  course_id uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Perfil de exibicao e contexto academico opcional. Instituicao e curso nao representam matricula oficial.'

  checks {
    `course_id IS NULL OR institution_id IS NOT NULL` [name: 'chk_user_profile_course_requires_institution']
  }
}

Table auth_tokens {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  type auth_token_type [not null]
  token_hash text [not null, unique]
  expires_at timestamptz [not null]
  used_at timestamptz
  revoked_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  Note: 'Tokens de uso unico para verificacao de e-mail e recuperacao de senha. Somente o hash do token e persistido.'

  indexes {
    (user_id, type, expires_at)
  }
}

//////////////////////////////////////////////
// MEDIA
//////////////////////////////////////////////

Table files {
  id uuid [pk, default: `gen_random_uuid()`]
  owner_id uuid [not null]
  purpose file_purpose [not null]
  storage_provider varchar(40) [not null, default: 'object_storage']
  storage_key text [not null, unique]
  original_filename varchar(255)
  mime_type varchar(150) [not null]
  size_bytes bigint [not null]
  checksum_sha256 char(64)
  created_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Note: 'Metadados e referencia de arquivo externo. O binario nunca e armazenado no PostgreSQL.'

  indexes {
    (owner_id)
    (purpose)
  }

  checks {
    `size_bytes > 0` [name: 'chk_files_positive_size']
  }
}

//////////////////////////////////////////////
// ACADEMIC
//////////////////////////////////////////////

Table institutions {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(200) [not null]
  short_name varchar(50)
  timezone varchar(64) [not null, default: 'America/Sao_Paulo']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Instituicao academica. timezone deve usar um identificador IANA validado pelo backend.'

  indexes {
    (`lower(name)`)
  }
}

Table courses {
  id uuid [pk, default: `gen_random_uuid()`]
  institution_id uuid [not null]
  name varchar(200) [not null]
  code varchar(40)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (id, institution_id) [unique]
    (institution_id, name) [unique]
    (institution_id, code) [unique]
  }
}

Table subjects {
  id uuid [pk, default: `gen_random_uuid()`]
  institution_id uuid [not null]
  name varchar(200) [not null]
  code varchar(40)
  description text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Disciplina de catalogo pertencente a uma instituicao, independente de periodo, turma e professor.'

  indexes {
    (id, institution_id) [unique]
    (institution_id, name) [unique]
    (institution_id, code) [unique]
    (`lower(name)`)
  }
}

Table course_subjects {
  course_id uuid [not null]
  subject_id uuid [not null]
  institution_id uuid [not null]

  Note: 'Associacao entre curso e disciplina dentro da mesma instituicao. Uma disciplina pode ser compartilhada por varios cursos.'

  indexes {
    (course_id, subject_id) [pk]
    (subject_id)
  }
}

Table academic_terms {
  id uuid [pk, default: `gen_random_uuid()`]
  institution_id uuid [not null]
  label varchar(30) [not null]
  start_date date [not null]
  end_date date [not null]

  indexes {
    (id, institution_id) [unique]
    (institution_id, label) [unique]
  }

  checks {
    `end_date >= start_date` [name: 'chk_academic_terms_date_range']
  }
}

Table teachers {
  id uuid [pk, default: `gen_random_uuid()`]
  institution_id uuid [not null]
  user_id uuid
  full_name varchar(200) [not null]
  external_code varchar(50)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Docente institucional. Pode existir sem conta no nexoAula; user_id e apenas uma vinculacao opcional.'

  indexes {
    (id, institution_id) [unique]
    (institution_id, user_id) [unique]
    (institution_id, external_code) [unique]
    (`lower(full_name)`)
  }
}

Table class_sections {
  id uuid [pk, default: `gen_random_uuid()`]
  institution_id uuid [not null]
  subject_id uuid [not null]
  academic_term_id uuid [not null]
  label varchar(80) [not null]
  created_by uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Oferta concreta de uma disciplina em um periodo academico. institution_id e repetido de forma controlada para impedir cruzamentos entre instituicoes.'

  indexes {
    (id, institution_id) [unique]
    (id, subject_id) [unique]
    (subject_id, academic_term_id, label) [unique]
    (academic_term_id)
  }
}

Table class_section_teachers {
  id uuid [pk, default: `gen_random_uuid()`]
  class_section_id uuid [not null]
  teacher_id uuid [not null]
  institution_id uuid [not null]
  role section_teacher_role [not null, default: 'lead']
  starts_on date [not null]
  ends_on date
  created_at timestamptz [not null, default: `now()`]

  Note: 'Vinculo de docente com uma turma. Datas opcionais permitem registrar substituicoes e co-docencia sem apagar quem ministrou anteriormente.'

  indexes {
    (class_section_id, teacher_id, starts_on) [unique]
    (teacher_id)
  }

  checks {
    `ends_on IS NULL OR ends_on >= starts_on` [name: 'chk_section_teachers_date_range']
  }
}

Table class_section_schedules {
  id uuid [pk, default: `gen_random_uuid()`]
  class_section_id uuid [not null]
  day_of_week smallint [not null]
  start_time time [not null]
  end_time time [not null]
  location varchar(150)
  effective_from date
  effective_until date

  Note: 'Padrao recorrente em horario local da instituicao. Instantes concretos de aulas usam timestamptz em scheduled_lessons e lesson_occurrences.'

  indexes {
    (class_section_id, day_of_week)
  }

  checks {
    `day_of_week BETWEEN 1 AND 7` [name: 'chk_section_schedules_day_of_week']
    `end_time > start_time` [name: 'chk_section_schedules_time_range']
    `effective_until IS NULL OR effective_from IS NULL OR effective_until >= effective_from` [name: 'chk_section_schedules_effective_range']
  }
}

Table user_class_sections {
  user_id uuid [not null]
  class_section_id uuid [not null]
  followed_at timestamptz [not null, default: `now()`]

  Note: 'Turma acompanhada pelo estudante no produto. Nao representa matricula oficial na instituicao.'

  indexes {
    (user_id, class_section_id) [pk]
    (class_section_id)
  }
}

//////////////////////////////////////////////
// ACADEMIC PLANNING
//////////////////////////////////////////////

Table topics {
  id uuid [pk, default: `gen_random_uuid()`]
  slug varchar(180) [not null, unique]
  name varchar(150) [not null]
  description text
  created_at timestamptz [not null, default: `now()`]

  Note: 'Conceito academico reutilizavel entre disciplinas. slug e a chave normalizada; o contexto dentro de cada disciplina fica em subject_topics.'

  indexes {
    (`lower(name)`)
  }
}

Table subject_topics {
  id uuid [pk, default: `gen_random_uuid()`]
  subject_id uuid [not null]
  topic_id uuid [not null]
  display_order integer
  created_at timestamptz [not null, default: `now()`]

  Note: 'Contextualiza um topic dentro de uma disciplina. E a referencia usada por aulas, progresso, grupos, materiais e sessoes.'

  indexes {
    (subject_id, topic_id) [unique]
    (id, subject_id) [unique]
    (topic_id)
  }

  checks {
    `display_order IS NULL OR display_order > 0` [name: 'chk_subject_topics_display_order']
  }
}

Table teaching_plans {
  id uuid [pk, default: `gen_random_uuid()`]
  class_section_id uuid [not null]
  version integer [not null]
  status teaching_plan_status [not null, default: 'draft']
  based_on_plan_id uuid
  created_by uuid [not null]
  published_by uuid
  created_at timestamptz [not null, default: `now()`]
  published_at timestamptz

  Note: 'Versao do planejamento de uma turma. Versoes publicadas sao imutaveis; uma correcao aprovada cria nova versao, preservando o planejamento anterior.'

  indexes {
    (class_section_id, version) [unique]
    (class_section_id, status)
  }

  checks {
    `version > 0` [name: 'chk_teaching_plans_positive_version']
    `status = 'draft' OR (published_by IS NOT NULL AND published_at IS NOT NULL)` [name: 'chk_teaching_plans_publication_data']
    `based_on_plan_id IS NULL OR based_on_plan_id <> id` [name: 'chk_teaching_plans_not_self_based']
  }
}

Table teaching_plan_imports {
  id uuid [pk, default: `gen_random_uuid()`]
  teaching_plan_id uuid [not null]
  source_file_id uuid [not null]
  status teaching_plan_import_status [not null, default: 'pending']
  extractor_key varchar(80)
  extractor_version varchar(40)
  confidence_score numeric(5,4)
  raw_extracted_data jsonb
  requested_by uuid [not null]
  reviewed_by uuid
  reviewed_at timestamptz
  error_message text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Tentativa de extracao ligada a um plano em rascunho. O JSONB guarda somente o payload bruto; dados revisados sao persistidos nas tabelas relacionais antes da publicacao.'

  indexes {
    (teaching_plan_id, created_at)
    (status, created_at)
  }

  checks {
    `confidence_score IS NULL OR confidence_score BETWEEN 0 AND 1` [name: 'chk_plan_imports_confidence']
    `raw_extracted_data IS NULL OR jsonb_typeof(raw_extracted_data) = 'object'` [name: 'chk_plan_imports_raw_object']
    `status NOT IN ('reviewed', 'applied') OR (reviewed_by IS NOT NULL AND reviewed_at IS NOT NULL)` [name: 'chk_plan_imports_review_data']
  }
}

Table scheduled_lessons {
  id uuid [pk, default: `gen_random_uuid()`]
  teaching_plan_id uuid [not null]
  sequence_number integer
  planned_start_at timestamptz [not null]
  planned_end_at timestamptz
  title varchar(200)
  description text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'PREVISTO. Aula planejada dentro de uma versao de plano. Nao recebe atualizacoes sobre o que aconteceu de fato.'

  indexes {
    (teaching_plan_id, planned_start_at)
    (teaching_plan_id, sequence_number) [unique]
  }

  checks {
    `sequence_number IS NULL OR sequence_number > 0` [name: 'chk_scheduled_lessons_sequence']
    `planned_end_at IS NULL OR planned_end_at > planned_start_at` [name: 'chk_scheduled_lessons_time_range']
  }
}

Table scheduled_lesson_topics {
  scheduled_lesson_id uuid [not null]
  subject_topic_id uuid [not null]

  indexes {
    (scheduled_lesson_id, subject_topic_id) [pk]
    (subject_topic_id)
  }
}

Table lesson_occurrences {
  id uuid [pk, default: `gen_random_uuid()`]
  class_section_id uuid [not null]
  scheduled_lesson_id uuid
  supersedes_occurrence_id uuid [unique]
  status lesson_occurrence_status [not null]
  actual_started_at timestamptz
  actual_ended_at timestamptz
  rescheduled_to timestamptz
  notes text
  recorded_by uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  Note: 'REALIZADO. Registro append-only do resultado de uma aula. Correcao cria nova linha por supersedes_occurrence_id; aula extra pode nao ter scheduled_lesson_id.'

  indexes {
    (class_section_id, created_at)
    (scheduled_lesson_id, created_at)
  }

  checks {
    `actual_ended_at IS NULL OR (actual_started_at IS NOT NULL AND actual_ended_at > actual_started_at)` [name: 'chk_lesson_occurrences_time_range']
    `(status = 'held' AND actual_started_at IS NOT NULL AND rescheduled_to IS NULL) OR (status = 'cancelled' AND actual_started_at IS NULL AND actual_ended_at IS NULL AND rescheduled_to IS NULL) OR (status = 'postponed' AND actual_started_at IS NULL AND actual_ended_at IS NULL AND rescheduled_to IS NOT NULL)` [name: 'chk_lesson_occurrences_status_fields']
    `supersedes_occurrence_id IS NULL OR supersedes_occurrence_id <> id` [name: 'chk_lesson_occurrences_not_self_superseding']
  }
}

Table occurrence_topics {
  lesson_occurrence_id uuid [not null]
  subject_topic_id uuid [not null]

  indexes {
    (lesson_occurrence_id, subject_topic_id) [pk]
    (subject_topic_id)
  }
}

Table student_lesson_attendance {
  user_id uuid [not null]
  lesson_occurrence_id uuid [not null]
  status attendance_status [not null]
  notes text
  updated_at timestamptz [not null, default: `now()`]

  Note: 'MEU REGISTRO. Presenca privada em uma aula efetivamente realizada. Ausencia de linha significa ainda nao informado.'

  indexes {
    (user_id, lesson_occurrence_id) [pk]
    (lesson_occurrence_id)
  }
}

Table student_topic_progress {
  user_id uuid [not null]
  class_section_id uuid [not null]
  subject_topic_id uuid [not null]
  status topic_progress_status [not null, default: 'pending']
  notes text
  updated_at timestamptz [not null, default: `now()`]

  Note: 'MEU REGISTRO. Progresso privado contextualizado por turma e conteudo; evita que um mesmo topic global misture situacoes academicas distintas.'

  indexes {
    (user_id, class_section_id, subject_topic_id) [pk]
    (user_id, status)
    (subject_topic_id)
  }
}

Table planning_corrections {
  id uuid [pk, default: `gen_random_uuid()`]
  suggested_by uuid [not null]
  scheduled_lesson_id uuid
  lesson_occurrence_id uuid
  kind planning_correction_kind [not null]
  original_snapshot jsonb [not null]
  proposed_patch jsonb [not null]
  reason text
  status correction_status [not null, default: 'pending']
  decided_by uuid
  decided_at timestamptz
  decision_note text
  created_at timestamptz [not null, default: `now()`]

  Note: 'Solicitacao auditavel de correcao. JSONB e usado apenas para o patch heterogeneo e seu snapshot; o estado academico oficial continua relacional.'

  indexes {
    (status, created_at)
    (suggested_by)
  }

  checks {
    `num_nonnulls(scheduled_lesson_id, lesson_occurrence_id) = 1` [name: 'chk_planning_corrections_single_target']
    `jsonb_typeof(original_snapshot) = 'object'` [name: 'chk_planning_corrections_snapshot_object']
    `jsonb_typeof(proposed_patch) = 'object'` [name: 'chk_planning_corrections_patch_object']
    `(status = 'pending' AND decided_by IS NULL AND decided_at IS NULL) OR (status IN ('approved', 'rejected') AND decided_by IS NOT NULL AND decided_at IS NOT NULL)` [name: 'chk_planning_corrections_decision']
  }
}

//////////////////////////////////////////////
// COMMUNITY
//////////////////////////////////////////////

Table study_groups {
  id uuid [pk, default: `gen_random_uuid()`]
  created_by uuid [not null]
  subject_id uuid [not null]
  class_section_id uuid
  name varchar(150) [not null]
  description text
  visibility group_visibility [not null, default: 'public']
  join_policy group_join_policy [not null, default: 'approval_required']
  status group_status [not null, default: 'active']
  capacity integer
  cover_file_id uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Note: 'Grupo de estudo ligado obrigatoriamente a uma disciplina e opcionalmente a uma turma. created_by e historico; o proprietario atual e o membro ativo com role owner.'

  indexes {
    (subject_id, status)
    (class_section_id)
    (`lower(name)`)
  }

  checks {
    `capacity IS NULL OR capacity > 0` [name: 'chk_study_groups_capacity']
  }
}

Table group_members {
  group_id uuid [not null]
  user_id uuid [not null]
  role membership_role [not null, default: 'member']
  status membership_status [not null, default: 'active']
  joined_at timestamptz [not null, default: `now()`]
  ended_at timestamptz
  removed_by uuid

  Note: 'Estado atual da participacao. O proprietario atual existe apenas aqui; transferencia de posse e operacao transacional.'

  indexes {
    (group_id, user_id) [pk]
    (user_id, status)
  }

  checks {
    `(status = 'active' AND ended_at IS NULL AND removed_by IS NULL) OR (status = 'left' AND ended_at IS NOT NULL AND removed_by IS NULL) OR (status = 'removed' AND ended_at IS NOT NULL AND removed_by IS NOT NULL)` [name: 'chk_group_members_lifecycle']
  }
}

Table group_join_requests {
  id uuid [pk, default: `gen_random_uuid()`]
  group_id uuid [not null]
  user_id uuid [not null]
  status join_request_status [not null, default: 'pending']
  requested_at timestamptz [not null, default: `now()`]
  resolved_by uuid
  resolved_at timestamptz
  resolution_note text

  Note: 'Cada linha e uma tentativa de entrada e preserva o historico. Apenas uma solicitacao pendente por usuario/grupo e permitida por regra parcial na migracao PostgreSQL.'

  indexes {
    (group_id, user_id, status)
    (user_id, status)
  }

  checks {
    `(status = 'pending' AND resolved_by IS NULL AND resolved_at IS NULL) OR (status <> 'pending' AND resolved_by IS NOT NULL AND resolved_at IS NOT NULL)` [name: 'chk_join_requests_resolution']
  }
}

Table group_topics {
  group_id uuid [not null]
  subject_topic_id uuid [not null]

  indexes {
    (group_id, subject_topic_id) [pk]
    (subject_topic_id)
  }
}

Table channels {
  id uuid [pk, default: `gen_random_uuid()`]
  group_id uuid [not null]
  subject_topic_id uuid
  name varchar(80) [not null]
  description text
  created_by uuid [not null]
  status channel_status [not null, default: 'active']
  created_at timestamptz [not null, default: `now()`]
  archived_at timestamptz

  Note: 'Canal de texto dentro do grupo. O conteudo academico e opcional para permitir canais gerais.'

  indexes {
    (group_id, name) [unique]
    (subject_topic_id)
  }

  checks {
    `(status = 'active' AND archived_at IS NULL) OR (status = 'archived' AND archived_at IS NOT NULL)` [name: 'chk_channels_archive_state']
  }
}

Table channel_messages {
  id uuid [pk, default: `gen_random_uuid()`]
  channel_id uuid [not null]
  author_id uuid [not null]
  reply_to_message_id uuid
  content text [not null]
  created_at timestamptz [not null, default: `now()`]
  edited_at timestamptz
  deleted_at timestamptz

  Note: 'Mensagem de canal com edicao, exclusao logica e resposta opcional. Nao representa mensagem privada.'

  indexes {
    (channel_id, created_at)
    (author_id, created_at)
  }
}

Table meetings {
  id uuid [pk, default: `gen_random_uuid()`]
  group_id uuid [not null]
  channel_id uuid
  organizer_id uuid [not null]
  title varchar(200) [not null]
  description text
  modality meeting_modality [not null]
  location varchar(250)
  external_url text
  starts_at timestamptz [not null]
  ends_at timestamptz
  status meeting_status [not null, default: 'scheduled']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Encontro comunitario gratuito. Usa local e/ou URL externa conforme a modalidade; nao implementa videoconferencia propria.'

  indexes {
    (group_id, starts_at)
    (status, starts_at)
  }

  checks {
    `ends_at IS NULL OR ends_at > starts_at` [name: 'chk_meetings_time_range']
    `(modality = 'in_person' AND location IS NOT NULL) OR (modality = 'online' AND external_url IS NOT NULL) OR (modality = 'hybrid' AND location IS NOT NULL AND external_url IS NOT NULL)` [name: 'chk_meetings_modality_fields']
  }
}

Table meeting_participants {
  meeting_id uuid [not null]
  user_id uuid [not null]
  status meeting_participant_status [not null, default: 'interested']
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (meeting_id, user_id) [pk]
    (user_id, status)
  }
}

Table meeting_topics {
  meeting_id uuid [not null]
  subject_topic_id uuid [not null]

  indexes {
    (meeting_id, subject_topic_id) [pk]
    (subject_topic_id)
  }
}

//////////////////////////////////////////////
// MARKETPLACE
//////////////////////////////////////////////

Table tutor_profiles {
  user_id uuid [pk]
  headline varchar(200)
  bio text
  status tutor_profile_status [not null, default: 'active']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Extensao profissional opcional de users. Verificacao e derivada do credenciamento vigente, evitando duas fontes de verdade.'
}

Table tutor_subjects {
  tutor_user_id uuid [not null]
  subject_id uuid [not null]

  indexes {
    (tutor_user_id, subject_id) [pk]
    (subject_id)
  }
}

Table tutor_subject_topics {
  tutor_user_id uuid [not null]
  subject_topic_id uuid [not null]

  Note: 'Especializacao opcional do tutor em conteudos concretos, alem da associacao ampla por disciplina.'

  indexes {
    (tutor_user_id, subject_topic_id) [pk]
    (subject_topic_id)
  }
}

Table tutor_credentials {
  id uuid [pk, default: `gen_random_uuid()`]
  tutor_user_id uuid [not null]
  status tutor_credential_status [not null, default: 'pending']
  valid_from date
  valid_until date
  simulated_fee_cents integer [not null, default: 0]
  currency char(3) [not null, default: 'BRL']
  decided_by uuid
  decided_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  Note: 'Uma linha por ciclo de credenciamento ou renovacao. Preserva o historico sem armazenar cartao ou dado bancario real.'

  indexes {
    (tutor_user_id, status)
  }

  checks {
    `valid_until IS NULL OR valid_from IS NULL OR valid_until >= valid_from` [name: 'chk_tutor_credentials_validity']
    `simulated_fee_cents >= 0` [name: 'chk_tutor_credentials_fee']
    `currency ~ '^[A-Z]{3}$'` [name: 'chk_tutor_credentials_currency']
    `(status = 'pending' AND decided_by IS NULL AND decided_at IS NULL) OR (status <> 'pending' AND decided_by IS NOT NULL AND decided_at IS NOT NULL)` [name: 'chk_tutor_credentials_decision']
  }
}

Table materials {
  id uuid [pk, default: `gen_random_uuid()`]
  creator_user_id uuid [not null]
  subject_id uuid [not null]
  class_section_id uuid
  file_id uuid [not null]
  title varchar(200) [not null]
  description text
  status material_status [not null, default: 'draft']
  price_cents integer [not null, default: 0]
  currency char(3) [not null, default: 'BRL']
  published_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Note: 'Material autoral de um perfil profissional. A disciplina e obrigatoria; a turma e opcional para contextualizacao mais especifica.'

  indexes {
    (subject_id, status)
    (class_section_id)
    (creator_user_id, status)
    (`lower(title)`)
  }

  checks {
    `price_cents >= 0` [name: 'chk_materials_price']
    `currency ~ '^[A-Z]{3}$'` [name: 'chk_materials_currency']
    `status <> 'published' OR published_at IS NOT NULL` [name: 'chk_materials_publication']
  }
}

Table material_topics {
  material_id uuid [not null]
  subject_topic_id uuid [not null]

  indexes {
    (material_id, subject_topic_id) [pk]
    (subject_topic_id)
  }
}

Table tutor_sessions {
  id uuid [pk, default: `gen_random_uuid()`]
  tutor_user_id uuid [not null]
  subject_id uuid [not null]
  class_section_id uuid
  title varchar(200) [not null]
  description text
  modality meeting_modality [not null]
  location varchar(250)
  external_url text
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  capacity integer [not null]
  price_cents integer [not null]
  currency char(3) [not null, default: 'BRL']
  status tutor_session_status [not null, default: 'draft']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Sessao profissional orientada por tutor. E separada de meetings porque possui preco, capacidade comercial, reserva e transacao.'

  indexes {
    (tutor_user_id, starts_at)
    (subject_id, status, starts_at)
    (class_section_id)
  }

  checks {
    `ends_at > starts_at` [name: 'chk_tutor_sessions_time_range']
    `capacity > 0` [name: 'chk_tutor_sessions_capacity']
    `price_cents >= 0` [name: 'chk_tutor_sessions_price']
    `currency ~ '^[A-Z]{3}$'` [name: 'chk_tutor_sessions_currency']
    `(modality = 'in_person' AND location IS NOT NULL) OR (modality = 'online' AND external_url IS NOT NULL) OR (modality = 'hybrid' AND location IS NOT NULL AND external_url IS NOT NULL)` [name: 'chk_tutor_sessions_modality_fields']
  }
}

Table session_topics {
  session_id uuid [not null]
  subject_topic_id uuid [not null]

  indexes {
    (session_id, subject_topic_id) [pk]
    (subject_topic_id)
  }
}

Table session_bookings {
  id uuid [pk, default: `gen_random_uuid()`]
  session_id uuid [not null]
  user_id uuid [not null]
  status session_booking_status [not null, default: 'reserved']
  booked_at timestamptz [not null, default: `now()`]
  cancelled_at timestamptz
  attended_at timestamptz

  Note: 'Inscricao do estudante em sessao profissional. Separa participacao da tentativa de pagamento e permite registrar presenca ou no-show.'

  indexes {
    (session_id, user_id) [unique]
    (id, user_id) [unique]
    (user_id, status)
  }

  checks {
    `status <> 'cancelled' OR cancelled_at IS NOT NULL` [name: 'chk_session_bookings_cancellation']
    `status <> 'attended' OR attended_at IS NOT NULL` [name: 'chk_session_bookings_attendance']
  }
}

Table transactions {
  id uuid [pk, default: `gen_random_uuid()`]
  buyer_id uuid [not null]
  material_id uuid
  session_booking_id uuid
  amount_cents integer [not null]
  commission_cents integer [not null, default: 0]
  currency char(3) [not null, default: 'BRL']
  status transaction_status [not null, default: 'pending']
  created_at timestamptz [not null, default: `now()`]
  completed_at timestamptz
  refunded_at timestamptz

  Note: 'Transacao simulada generica. O alvo e exatamente um material ou uma reserva de sessao; valores sao snapshots historicos em centavos.'

  indexes {
    (buyer_id, created_at)
    (material_id)
    (session_booking_id)
    (status, created_at)
  }

  checks {
    `num_nonnulls(material_id, session_booking_id) = 1` [name: 'chk_transactions_single_target']
    `amount_cents >= 0` [name: 'chk_transactions_amount']
    `commission_cents >= 0 AND commission_cents <= amount_cents` [name: 'chk_transactions_commission']
    `currency ~ '^[A-Z]{3}$'` [name: 'chk_transactions_currency']
    `(status IN ('completed', 'refunded') AND completed_at IS NOT NULL) OR (status NOT IN ('completed', 'refunded') AND completed_at IS NULL)` [name: 'chk_transactions_completion']
    `(status = 'refunded' AND refunded_at IS NOT NULL) OR (status <> 'refunded' AND refunded_at IS NULL)` [name: 'chk_transactions_refund']
  }
}

Table reviews {
  id uuid [pk, default: `gen_random_uuid()`]
  transaction_id uuid [not null, unique]
  rating smallint [not null]
  comment text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Avaliacao vinculada a uma unica experiencia transacionada. Autor e tutor avaliado sao derivados da transacao e de seu alvo, eliminando combinacoes inconsistentes.'

  checks {
    `rating BETWEEN 1 AND 5` [name: 'chk_reviews_rating']
  }
}

//////////////////////////////////////////////
// REFERENCES
//////////////////////////////////////////////

Ref: user_profiles.user_id > users.id [delete: cascade]
Ref: user_profiles.avatar_file_id > files.id [delete: set null]
