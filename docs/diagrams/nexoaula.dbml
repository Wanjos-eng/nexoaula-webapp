Ref: user_profiles.(course_id, institution_id) > courses.(id, institution_id) [delete: restrict]
Ref: auth_tokens.user_id > users.id [delete: cascade]
Ref: files.owner_id > users.id [delete: restrict]

Ref: courses.institution_id > institutions.id [delete: restrict]
Ref: subjects.institution_id > institutions.id [delete: restrict]
Ref: course_subjects.(course_id, institution_id) > courses.(id, institution_id) [delete: cascade]
Ref: course_subjects.(subject_id, institution_id) > subjects.(id, institution_id) [delete: cascade]
Ref: academic_terms.institution_id > institutions.id [delete: restrict]
Ref: teachers.institution_id > institutions.id [delete: restrict]
Ref: teachers.user_id > users.id [delete: set null]
Ref: class_sections.(subject_id, institution_id) > subjects.(id, institution_id) [delete: restrict]
Ref: class_sections.(academic_term_id, institution_id) > academic_terms.(id, institution_id) [delete: restrict]
Ref: class_sections.created_by > users.id [delete: restrict]
Ref: class_section_teachers.(class_section_id, institution_id) > class_sections.(id, institution_id) [delete: cascade]
Ref: class_section_teachers.(teacher_id, institution_id) > teachers.(id, institution_id) [delete: restrict]
Ref: class_section_schedules.class_section_id > class_sections.id [delete: cascade]
Ref: user_class_sections.user_id > users.id [delete: cascade]
Ref: user_class_sections.class_section_id > class_sections.id [delete: cascade]

Ref: subject_topics.subject_id > subjects.id [delete: restrict]
Ref: subject_topics.topic_id > topics.id [delete: restrict]
Ref: teaching_plans.class_section_id > class_sections.id [delete: restrict]
Ref: teaching_plans.based_on_plan_id > teaching_plans.id [delete: restrict]
Ref: teaching_plans.created_by > users.id [delete: restrict]
Ref: teaching_plans.published_by > users.id [delete: restrict]
Ref: teaching_plan_imports.teaching_plan_id > teaching_plans.id [delete: cascade]
Ref: teaching_plan_imports.source_file_id > files.id [delete: restrict]
Ref: teaching_plan_imports.requested_by > users.id [delete: restrict]
Ref: teaching_plan_imports.reviewed_by > users.id [delete: restrict]
Ref: scheduled_lessons.teaching_plan_id > teaching_plans.id [delete: cascade]
Ref: scheduled_lesson_topics.scheduled_lesson_id > scheduled_lessons.id [delete: cascade]
Ref: scheduled_lesson_topics.subject_topic_id > subject_topics.id [delete: restrict]
Ref: lesson_occurrences.class_section_id > class_sections.id [delete: restrict]
Ref: lesson_occurrences.scheduled_lesson_id > scheduled_lessons.id [delete: restrict]
Ref: lesson_occurrences.supersedes_occurrence_id > lesson_occurrences.id [delete: restrict]
Ref: lesson_occurrences.recorded_by > users.id [delete: restrict]
Ref: occurrence_topics.lesson_occurrence_id > lesson_occurrences.id [delete: cascade]
Ref: occurrence_topics.subject_topic_id > subject_topics.id [delete: restrict]
Ref: student_lesson_attendance.user_id > users.id [delete: cascade]
Ref: student_lesson_attendance.lesson_occurrence_id > lesson_occurrences.id [delete: restrict]
Ref: student_topic_progress.user_id > users.id [delete: cascade]
Ref: student_topic_progress.class_section_id > class_sections.id [delete: restrict]
Ref: student_topic_progress.subject_topic_id > subject_topics.id [delete: restrict]
Ref: planning_corrections.suggested_by > users.id [delete: restrict]
Ref: planning_corrections.scheduled_lesson_id > scheduled_lessons.id [delete: restrict]
Ref: planning_corrections.lesson_occurrence_id > lesson_occurrences.id [delete: restrict]
Ref: planning_corrections.decided_by > users.id [delete: restrict]

Ref: study_groups.created_by > users.id [delete: restrict]
Ref: study_groups.subject_id > subjects.id [delete: restrict]
Ref: study_groups.(class_section_id, subject_id) > class_sections.(id, subject_id) [delete: restrict]
Ref: study_groups.cover_file_id > files.id [delete: set null]
Ref: group_members.group_id > study_groups.id [delete: cascade]
Ref: group_members.user_id > users.id [delete: restrict]
Ref: group_members.removed_by > users.id [delete: restrict]
Ref: group_join_requests.group_id > study_groups.id [delete: cascade]
Ref: group_join_requests.user_id > users.id [delete: restrict]
Ref: group_join_requests.resolved_by > users.id [delete: restrict]
Ref: group_topics.group_id > study_groups.id [delete: cascade]
Ref: group_topics.subject_topic_id > subject_topics.id [delete: restrict]
Ref: channels.group_id > study_groups.id [delete: cascade]
Ref: channels.subject_topic_id > subject_topics.id [delete: restrict]
