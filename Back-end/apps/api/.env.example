# Opcoes publicas e opcionais; o health funciona sem um arquivo .env.
PROJECT_NAME="nexoAula API"
VERSION="0.1.0"

# Apenas desenvolvimento local; substitua por segredo próprio fora desse ambiente.
DATABASE_URL="postgresql+psycopg2://nexoaula:nexoaula_local@localhost:5432/nexoaula"

# HTTPS é o padrão. HTTP local exige development explícito.
ENVIRONMENT="development"
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS='["http://localhost:3000","http://127.0.0.1:8000"]'
# Gere pelo menos 32 bytes aleatórios fora do repositório (ver README).
# AUTH_JWT_SECRET=
