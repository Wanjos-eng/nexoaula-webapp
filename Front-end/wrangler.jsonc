{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexoaula-web",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker.ts",
  "services": [{ "binding": "API", "service": "nexoaula-api" }],
  "observability": { "enabled": true },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  }
}
